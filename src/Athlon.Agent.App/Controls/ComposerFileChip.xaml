<UserControl x:Class="Athlon.Agent.App.Controls.ComposerFileChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Athlon.Agent.App.Controls"
             Focusable="False">
    <Border x:Name="ChipBorder"
            Background="{DynamicResource Brush.AtCompletionFileBadgeBg}"
            BorderBrush="{DynamicResource Brush.AtCompletionFileBadgeBorder}"
            BorderThickness="1"
            CornerRadius="11"
            Padding="8,2,8,2"
            Margin="0,1,2,1"
            VerticalAlignment="Center"
            SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <controls:WorkspaceFileIcon x:Name="FileIcon"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center" />
            <TextBlock x:Name="TypeBadgeText"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,5,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <TextBlock x:Name="FileNameText"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.AtCompletionFileBadgeText}" />
        </StackPanel>
    </Border>
</UserControl>
