<UserControl x:Class="Athlon.Agent.App.Controls.ComposerAttachmentChipsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  Margin="0,0,0,6">
        <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPendingAttachments}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Style>
        <StackPanel Orientation="Vertical">
            <TextBlock Margin="0,0,0,6"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.SubtleText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadingAttachments}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Text" Value="{loc:Localize Key=Chat_ReadingAttachments}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding PendingDocumentAttachments}"
                          Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ComposerPendingChipBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="180"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SizeLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.SubtleText}" />
                                    <TextBlock Text=" · "
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.SubtleText}" />
                                    <TextBlock Text="{loc:Localize Key=Chat_PendingParse}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.SubtleText}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="×"
                                        Command="{Binding DataContext.RemovePendingDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SessionDeleteButtonStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding PendingImageAttachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ComposerPendingChipBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Brush.Panel}"
                                        Margin="0,0,8,0">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           Margin="2" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FileName}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="180"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="×"
                                        Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SessionDeleteButtonStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
