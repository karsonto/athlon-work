<UserControl x:Class="Athlon.Agent.App.Controls.TerminalWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <Grid Background="{DynamicResource Brush.Panel}">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="280">
            <TextBlock Text=">_"
                       FontSize="28"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource Brush.SubtleText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <TextBlock Text="{loc:Localize Key=Workspace_TerminalPlaceholderTitle}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="{loc:Localize Key=Workspace_TerminalPlaceholderBody}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.SubtleText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
