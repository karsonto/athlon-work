<UserControl x:Class="Athlon.Agent.App.Controls.WorkspaceSkillsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Athlon.Agent.App.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <UserControl.Resources>
        <Style x:Key="SkillsSubTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SkillsPanelSubTabStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SkillsFilterChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SkillsPanelFilterChipStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="2" Margin="12,10,12,0">
            <Button Style="{StaticResource SkillsSubTabButtonStyle}"
                    Tag="{Binding Sidebar.IsSkillsSectionSelected}"
                    Command="{Binding Sidebar.ShowSkillsSectionCommand}"
                    Content="{Binding Sidebar.SkillsSectionLabel}"
                    Margin="0,0,4,0" />
            <Button Style="{StaticResource SkillsSubTabButtonStyle}"
                    Tag="{Binding Sidebar.IsMcpSectionSelected}"
                    Command="{Binding Sidebar.ShowMcpSectionCommand}"
                    Content="{Binding Sidebar.McpSectionLabel}"
                    Margin="4,0,0,0" />
        </UniformGrid>

        <!-- Skills -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sidebar.IsSkillsSectionSelected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,0,12,10"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Localize Key=Context_SkillsInstalledLabel}"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Sidebar.SkillsCountLabel}"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBox Text="{Binding Sidebar.SkillSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SkillsPanelSearchBoxStyle}"
                             ToolTip="{loc:Localize Key=Context_SkillsSearchPlaceholder}"
                             Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SkillsFilterChipButtonStyle}"
                                Tag="{Binding Sidebar.IsSkillFilterAll}"
                                Content="{loc:Localize Key=Context_SkillsFilterAll}"
                                Command="{Binding Sidebar.SetSkillFilterAllCommand}"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource SkillsFilterChipButtonStyle}"
                                Tag="{Binding Sidebar.IsSkillFilterEnabled}"
                                Content="{loc:Localize Key=Context_SkillsFilterEnabled}"
                                Command="{Binding Sidebar.SetSkillFilterEnabledCommand}"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource SkillsFilterChipButtonStyle}"
                                Tag="{Binding Sidebar.IsSkillFilterDisabled}"
                                Content="{loc:Localize Key=Context_SkillsFilterDisabled}"
                                Command="{Binding Sidebar.SetSkillFilterDisabledCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border VerticalAlignment="Center" Margin="16">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SkillsPanelEmptyCardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sidebar.HasInstalledSkills}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Sidebar.SkillsEmptyMessage}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Localize Key=Context_SkillsEmptyHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{loc:Localize Key=Context_OpenSkillHub}"
                                    Command="{Binding Sidebar.NavigateToSkillHubCommand}"
                                    Style="{StaticResource SkillsPanelPrimaryButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Content="{loc:Localize Key=Context_OpenSkillsFolder}"
                                    Command="{Binding Sidebar.OpenSkillsFolderCommand}"
                                    Style="{StaticResource SkillsPanelSecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Sidebar.FilteredSkills}"
                         SelectedItem="{Binding Sidebar.SelectedSkill, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Padding="8,6">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sidebar.HasInstalledSkills}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.HoverNeutralAlt}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0"
                                              Style="{StaticResource SkillsPanelToggleStyle}"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding ToggleCommand}"
                                              ToolTip="{loc:Localize Key=Context_SkillTagTooltip}"
                                              VerticalAlignment="Top"
                                              Margin="0,1,8,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Brush.SubtleText}"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Opacity" Value="0.7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{loc:Localize Key=Context_NoMatchingSkills}"
                           Foreground="{DynamicResource Brush.SubtleText}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Sidebar.HasInstalledSkills}" Value="True" />
                                        <Condition Binding="{Binding Sidebar.HasFilteredSkills}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource Brush.PanelAlt}"
                    Padding="12,10"
                    MaxHeight="160">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Sidebar.HasInstalledSkills}" Value="True" />
                                    <Condition Binding="{Binding Sidebar.HasSelectedSkill}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding Sidebar.SelectedSkill}">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Description}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                            <Setter Property="Text" Value="{loc:Localize Key=Context_NoSkillDescription}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DirectoryPath}"
                                   FontSize="10.5"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDirectory}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Localize Key=Context_OpenSkillHub}"
                                    Command="{Binding DataContext.Sidebar.NavigateToSkillHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource SkillsPanelPrimaryButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button Content="{loc:Localize Key=Context_OpenSkillsFolder}"
                                    Command="{Binding DataContext.Sidebar.OpenSelectedSkillFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource SkillsPanelSecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MCP -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sidebar.IsMcpSectionSelected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12,0,12,10"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Localize Key=Context_McpServers}"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Sidebar.McpCountLabel}"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBox Text="{Binding Sidebar.McpSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SkillsPanelSearchBoxStyle}"
                             ToolTip="{loc:Localize Key=Context_McpSearchPlaceholder}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border VerticalAlignment="Center" Margin="16">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SkillsPanelEmptyCardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sidebar.HasConfiguredMcpServers}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Sidebar.McpEmptyMessage}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Localize Key=Context_McpEmptyHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <Button Content="{loc:Localize Key=Context_OpenSettings}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Settings"
                                Style="{StaticResource SkillsPanelSecondaryButtonStyle}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Sidebar.FilteredMcpServers}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Padding="8,6">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sidebar.HasConfiguredMcpServers}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Chrome}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    ToolTip="{loc:Localize Key=Context_McpTagTooltip}">
                                <i:Interaction.Behaviors>
                                    <behaviors:CommandDoubleClickBehavior Command="{Binding ActivateCommand}" />
                                </i:Interaction.Behaviors>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"
                                                 Style="{StaticResource McpStatusIndicatorStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource McpStatusNameStyle}" />
                                        <Button Grid.Column="2"
                                                Command="{Binding ToggleExpandedCommand}"
                                                Content="{Binding ExpandLabel}"
                                                ToolTip="{loc:Localize Key=Context_McpExpandTooltip}"
                                                Padding="8,4"
                                                FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SkillsPanelSecondaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Padding" Value="8,4" />
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTools}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ToolNames}" Margin="16,8,0,0">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource Brush.SubtleText}"
                                                           FontSize="11"
                                                           Margin="0,1"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{loc:Localize Key=Context_NoMatchingMcp}"
                           Foreground="{DynamicResource Brush.SubtleText}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Sidebar.HasConfiguredMcpServers}" Value="True" />
                                        <Condition Binding="{Binding Sidebar.HasFilteredMcpServers}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
