<UserControl x:Class="Athlon.Agent.App.Controls.DebugActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Background="{DynamicResource Brush.SurfaceMuted}"
            BorderBrush="{DynamicResource Brush.ComposerBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10,8"
            Margin="0,0,0,8">
        <StackPanel>
            <TextBlock Text="{Binding PhaseLabel}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="{Binding Summary}"
                       TextWrapping="Wrap"
                       MaxHeight="120"
                       Margin="0,4,0,8"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Localize Key=Debug_MarkReproduced}"
                        Command="{Binding MarkReproducedCommand}"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowReproduced}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{loc:Localize Key=Debug_MarkFixed}"
                        Command="{Binding MarkFixedCommand}"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowVerify}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{loc:Localize Key=Debug_MarkNotFixed}"
                        Command="{Binding MarkNotFixedCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowVerify}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
