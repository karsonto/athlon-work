<UserControl x:Class="Athlon.Agent.App.Controls.ChangesReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Athlon.Agent.App.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Athlon.Agent.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ReviewViewportBand" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width" Value="{Binding ReviewViewportWidth, RelativeSource={RelativeSource AncestorType=controls:ChangesReviewView}}" />
        </Style>
        <Style x:Key="ReviewFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.HoverSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Brush.AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Padding="14,10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource Brush.Chrome}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Headline}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding AddedText}"
                           Margin="12,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Success}" />
                <TextBlock Text="{Binding RemovedText}"
                           Margin="8,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Danger}" />
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="ReviewScroller"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Background="Transparent">
        <ListBox x:Name="ReviewList"
                 ItemsSource="{Binding Rows}"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Height="{Binding ViewportHeight, ElementName=ReviewScroller}"
                 MinWidth="{Binding ViewportWidth, ElementName=ReviewScroller}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type vm:ChangesFileHeaderRowViewModel}">
                    <Button Command="{Binding ToggleCommand}"
                            Style="{StaticResource ReviewFlatButton}"
                            Padding="0"
                            Background="{DynamicResource Brush.Panel}">
                        <Grid Style="{StaticResource ReviewViewportBand}">
                            <Grid Margin="10,7,16,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Brush.SubtleText}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronRight" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Kind" Value="ChevronDown" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <controls:WorkspaceFileIcon Grid.Column="1"
                                                        Kind="{Binding IconKind}"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="8,0,8,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding RelativePath}"
                                       ToolTip="{Binding RelativePath}"
                                       FontSize="12"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding AddedText}"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Success}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddedText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding RemovedText}"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Danger}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RemovedText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </Grid>
                        </Grid>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ChangesFoldRowViewModel}">
                    <Button Command="{Binding ToggleCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ReviewFlatButton}">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter Property="MinHeight" Value="22" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid MinHeight="22" Style="{StaticResource ReviewViewportBand}">
                            <TextBlock Text="{Binding Text}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource Brush.SubtleText}" />
                            <materialDesign:PackIcon Width="14"
                                                     Height="14"
                                                     Margin="10,0,0,0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Brush.SubtleText}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronRight" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Kind" Value="ChevronDown" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ChangesCodeRowViewModel}">
                    <Grid MinHeight="20">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LineKind}" Value="added">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LineKind}" Value="removed">
                                        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSubtle}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LineNumber}"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="12"
                                   Padding="8,1,10,1"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.SubtleText}" />
                        <TextBlock Grid.Column="1"
                                   controls:DiffSyntaxText.Tokens="{Binding Tokens}"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="12"
                                   Padding="0,1,16,1"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.CodeForeground}" />
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ChangesNoteRowViewModel}">
                    <TextBlock Text="{Binding Text}"
                               Margin="16,10"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource Brush.SubtleText}" />
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
