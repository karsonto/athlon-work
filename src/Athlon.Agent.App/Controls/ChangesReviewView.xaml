<UserControl x:Class="Athlon.Agent.App.Controls.ChangesReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Padding="14,10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource Brush.Chrome}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Headline}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="{Binding AddedText}"
                           Margin="12,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Success}" />
                <TextBlock Text="{Binding RemovedText}"
                           Margin="8,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Danger}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource Brush.Panel}">
                <ListBox ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RelativePath}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativePath}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding AddedCount, StringFormat=+{0}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AddedCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding RemovedCount, StringFormat=-{0}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RemovedCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Grid Grid.Column="1" Background="{DynamicResource Brush.AppBackground}">
                <TextBlock Text="{Binding NoDiffText}"
                           Margin="16"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.SubtleText}"
                           VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNoDiff}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox ItemsSource="{Binding DiffLines}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNoDiff}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="added">
                                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="removed">
                                                <Setter Property="Background" Value="{DynamicResource Brush.ErrorSubtle}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding OldNumber}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Padding="6,1,4,1"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.SubtleText}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding NewNumber}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Padding="4,1"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.SubtleText}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Prefix}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Padding="2,1,0,1"
                                           Foreground="{DynamicResource Brush.SubtleText}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Text}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Padding="4,1,12,1"
                                           Foreground="{DynamicResource Brush.Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
