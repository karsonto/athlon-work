<UserControl x:Class="Athlon.Agent.App.Controls.ComposerContextMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:compaction="clr-namespace:Athlon.Agent.Core.Compaction;assembly=Athlon.Agent.Core"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
             xmlns:vm="clr-namespace:Athlon.Agent.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="OccupancySwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.SubtleText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="tools">
                    <Setter Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="rules">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="skills">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="mcp">
                    <Setter Property="Background" Value="{DynamicResource Brush.AtCompletionMcpBadgeText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="subagent">
                    <Setter Property="Background" Value="{DynamicResource Brush.CodeHighlightBlue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="conversation">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OccupancyBarSegmentStyle" TargetType="Border">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Brush.SubtleText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="tools">
                    <Setter Property="Background" Value="{DynamicResource Brush.TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="rules">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="skills">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="mcp">
                    <Setter Property="Background" Value="{DynamicResource Brush.AtCompletionMcpBadgeText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="subagent">
                    <Setter Property="Background" Value="{DynamicResource Brush.CodeHighlightBlue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="conversation">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter Property="CornerRadius" Value="2,0,0,2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter Property="CornerRadius" Value="0,2,2,0" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFirst}" Value="True" />
                        <Condition Binding="{Binding IsLast}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="CornerRadius" Value="2" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <Button x:Name="MeterButton"
                Click="MeterButton_OnClick"
                ToolTip="{loc:Localize Key=Chat_ContextMeterTooltip}"
                Width="28"
                Height="28"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Style="{StaticResource GhostIconButtonStyle}">
            <Grid Width="16" Height="16">
                <Ellipse Width="16"
                         Height="16"
                         Stroke="{DynamicResource Brush.Border}"
                         StrokeThickness="2.2"
                         Fill="Transparent" />
                <Ellipse Width="16"
                         Height="16"
                         StrokeThickness="2.2"
                         Fill="Transparent"
                         StrokeDashArray="{Binding RingDashArray}"
                         StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.Elevated}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.High}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.Critical}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.Overflow}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </Button>
        <Popup PlacementTarget="{Binding ElementName=MeterButton}"
               Placement="Top"
               IsOpen="{Binding IsFlyoutOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    MinWidth="260"
                    MaxWidth="320"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding PercentLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.SubtleText}" />
                        <TextBlock Text="{Binding UsedCapacityLabel}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.SubtleText}" />
                    </Grid>
                    <Grid Height="8" Margin="0,0,0,10">
                        <Border Background="{DynamicResource Brush.Border}"
                                CornerRadius="2" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ContextOccupancyCategoryRow}">
                                    <Border Width="{Binding BarWidth}"
                                            Style="{StaticResource OccupancyBarSegmentStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContextOccupancyCategoryRow}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource OccupancySwatchStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,8,0"
                                               FontSize="12"
                                               Text="{Binding Label}"
                                               Foreground="{DynamicResource Brush.Text}" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="12"
                                               Text="{Binding TokensLabel}"
                                               Foreground="{DynamicResource Brush.SubtleText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Localize Key=Shell_CompactingContext}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.SubtleText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompacting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{loc:Localize Key=Shell_CompactContextTitle}"
                            Command="{Binding CompactCommand}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactCtaEmphasized}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:Localize Key=Shell_ClearContextTitle}"
                            Command="{Binding ClearCommand}"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource GhostButtonStyle}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
