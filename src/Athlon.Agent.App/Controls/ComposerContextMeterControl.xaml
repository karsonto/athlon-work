<UserControl x:Class="Athlon.Agent.App.Controls.ComposerContextMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:compaction="clr-namespace:Athlon.Agent.Core.Compaction;assembly=Athlon.Agent.Core"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid>
        <Button x:Name="MeterButton"
                Click="MeterButton_OnClick"
                ToolTip="{loc:Localize Key=Chat_ContextMeterTooltip}"
                Width="28"
                Height="28"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Style="{StaticResource GhostIconButtonStyle}">
            <Grid Width="16" Height="16">
                <Ellipse Width="16"
                         Height="16"
                         Stroke="{DynamicResource Brush.Border}"
                         StrokeThickness="2.2"
                         Fill="Transparent" />
                <Ellipse Width="16"
                         Height="16"
                         StrokeThickness="2.2"
                         Fill="Transparent"
                         StrokeDashArray="{Binding RingDashArray}"
                         StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.Elevated}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.High}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.Critical}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Pressure}" Value="{x:Static compaction:ContextPressureLevel.Overflow}">
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </Button>
        <Popup PlacementTarget="{Binding ElementName=MeterButton}"
               Placement="Top"
               IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    MinWidth="240"
                    MaxWidth="320"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{Binding PercentLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding UsedCapacityLabel}"
                               FontSize="12"
                               Margin="0,2,0,8"
                               Foreground="{DynamicResource Brush.SubtleText}" />
                    <StackPanel Orientation="Horizontal" Height="8">
                        <Border Width="{Binding HistoryBarWidth}"
                                Height="8"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="2,0,0,2" />
                        <Border Width="{Binding SystemBarWidth}"
                                Height="8"
                                Background="{DynamicResource Brush.Text}" />
                        <Border Width="{Binding ToolsBarWidth}"
                                Height="8"
                                Background="{DynamicResource Brush.SubtleText}" />
                        <Border Width="{Binding MarginBarWidth}"
                                Height="8"
                                Background="{DynamicResource Brush.Border}"
                                CornerRadius="0,2,2,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding HistoryLabel}" FontSize="11" Margin="0,8,0,2" Foreground="{DynamicResource Brush.SubtleText}" />
                    <TextBlock Text="{Binding SystemLabel}" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource Brush.SubtleText}" />
                    <TextBlock Text="{Binding ToolsLabel}" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource Brush.SubtleText}" />
                    <TextBlock Text="{Binding MarginLabel}" FontSize="11" Foreground="{DynamicResource Brush.SubtleText}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
