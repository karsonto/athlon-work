<UserControl x:Class="Athlon.Agent.App.Controls.ComposerPlusMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <Grid>
        <Button x:Name="PlusMenuButton"
                Command="{Binding TogglePlusMenuCommand}"
                ToolTip="{loc:Localize Key=ComposerPlus_MenuTooltip}"
                Style="{StaticResource ComposerToolButtonStyle}">
            <Canvas Width="10"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                <Rectangle Canvas.Left="0"
                           Canvas.Top="4"
                           Width="10"
                           Height="2"
                           RadiusX="1"
                           RadiusY="1"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                <Rectangle Canvas.Left="4"
                           Canvas.Top="0"
                           Width="2"
                           Height="10"
                           RadiusX="1"
                           RadiusY="1"
                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
            </Canvas>
        </Button>
        <Popup PlacementTarget="{Binding ElementName=PlusMenuButton}"
               Placement="Top"
               IsOpen="{Binding IsPlusMenuOpen, Mode=TwoWay}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    MinWidth="280"
                    MaxWidth="420"
                    MaxHeight="480"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Command="{Binding PlusSelectImagesCommand}"
                                Style="{StaticResource ComposerPlusMenuItemStyle}"
                                ToolTip="{loc:Localize Key=Chat_UploadImageTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16"
                                         Height="16"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"
                                         Stretch="Uniform">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M4,1.75 H9.1 L12.25,4.9 V14.25 H4 Z"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                        <Path Data="M9.1,1.75 V4.9 H12.25"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                        <Line X1="6" Y1="8" X2="10.25" Y2="8"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeThickness="1.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <Line X1="6" Y1="10.75" X2="10.25" Y2="10.75"
                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              StrokeThickness="1.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{loc:Localize Key=ComposerPlus_Image}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{loc:Localize Key=ComposerPlus_Knowledge}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   FontSize="11"
                                   Margin="4,10,0,6"
                                   IsEnabled="{Binding ComposerKnowledge.IsKnowledgeButtonEnabled}" />
                        <StackPanel IsEnabled="{Binding ComposerKnowledge.IsKnowledgeButtonEnabled}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBox Text="{Binding ComposerKnowledge.ModuleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ComposerKnowledgeSearchBoxStyle}"
                                     ToolTip="{Binding ComposerKnowledge.KnowledgeButtonToolTip}" />
                            <ListBox ItemsSource="{Binding ComposerKnowledge.FilteredModulesView}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MaxHeight="200"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding MetaText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.SubtleText}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
