<UserControl x:Class="Athlon.Agent.App.Controls.BrowserWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding GoBackCommand}"
                            Content="←"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{loc:Localize Key=Workspace_BrowserBack}" />
                    <Button Command="{Binding GoForwardCommand}"
                            Content="→"
                            Width="28"
                            Height="28"
                            Margin="0,0,4,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{loc:Localize Key=Workspace_BrowserForward}" />
                    <Button Command="{Binding ReloadCommand}"
                            Content="↻"
                            Width="28"
                            Height="28"
                            Margin="0,0,8,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{loc:Localize Key=Workspace_BrowserReload}" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="10,6"
                         FontSize="13"
                         KeyDown="AddressBox_OnKeyDown" />
                <Button Grid.Column="2"
                        Command="{Binding NavigateCommand}"
                        Content="{loc:Localize Key=Workspace_BrowserGo}"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Style="{StaticResource GhostButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.AppBackground}">
            <wv2:WebView2 x:Name="BrowserWebView"
                          DefaultBackgroundColor="Transparent" />
        </Border>
    </Grid>
</UserControl>
