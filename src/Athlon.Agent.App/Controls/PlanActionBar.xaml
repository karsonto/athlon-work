<UserControl x:Class="Athlon.Agent.App.Controls.PlanActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Build lives only on the timeline plan-ready card; this control stays collapsed
         while PlanActionBarViewModel still owns BuildCommand + composer hints. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Style>
    <Border Width="0" Height="0" />
</UserControl>
