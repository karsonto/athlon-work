<UserControl x:Class="Athlon.Agent.App.Controls.PlanActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Background="{DynamicResource Brush.Composer}"
            BorderBrush="{DynamicResource Brush.ModePlanBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,12"
            Margin="0,0,0,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        CornerRadius="4"
                        Background="{DynamicResource Brush.ModePlanBg}"
                        VerticalAlignment="Center">
                    <TextBlock Text="☰"
                               FontSize="10"
                               Foreground="{DynamicResource Brush.ModePlanBorder}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-1,0,0" />
                </Border>
                <TextBlock Text="{Binding PhaseLabel}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Text}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          Margin="0,10,0,12"
                          MaxHeight="180"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Summary}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{DynamicResource Brush.Text}"
                           Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
            </ScrollViewer>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{loc:Localize Key=Harness_PlanRevise}"
                        Command="{Binding ReviseCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRevise}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{loc:Localize Key=Harness_PlanBuild}"
                        ToolTip="{loc:Localize Key=Harness_PlanBuildTooltip}"
                        Command="{Binding BuildCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Padding" Value="14,6" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Background" Value="{DynamicResource Brush.HoverNeutralAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowBuild}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
