<UserControl x:Class="Athlon.Agent.App.Controls.PlanActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Background="{DynamicResource Brush.Composer}"
            BorderBrush="{DynamicResource Brush.ModePlanBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10,8"
            Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{loc:Localize Key=Harness_PlanBuild}"
                    ToolTip="{loc:Localize Key=Harness_PlanBuildTooltip}"
                    Command="{Binding BuildCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Background" Value="{DynamicResource Brush.HoverNeutralAlt}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBuild}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
