<UserControl x:Class="Athlon.Agent.App.Controls.WelcomeBuddyIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False"
             AutomationProperties.Name="Athlon">
    <Viewbox Stretch="Uniform">
        <Grid Width="64" Height="64">
            <!-- 0 Monday 微笑 -->
            <Canvas x:Name="Face0" Width="64" Height="64" Visibility="Collapsed">
                <Ellipse Width="64" Height="64" Fill="#D4E8FC" />
                <Rectangle Canvas.Left="22" Canvas.Top="16.4" Width="6.4" Height="11.4" RadiusX="3.2" RadiusY="3.2" Fill="#2E3540" />
                <Rectangle Canvas.Left="35.6" Canvas.Top="16.4" Width="6.4" Height="11.4" RadiusX="3.2" RadiusY="3.2" Fill="#2E3540" />
                <Path Data="M20,35.2 C26.2,46.4 37.8,46.4 44,35.2"
                      Stroke="#2E3540" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            </Canvas>
            <!-- 1 Tuesday 眨眼 -->
            <Canvas x:Name="Face1" Width="64" Height="64" Visibility="Collapsed">
                <Ellipse Width="64" Height="64" Fill="#D4E8FC" />
                <Rectangle Canvas.Left="26.5" Canvas.Top="15.4" Width="6.3" Height="11.8" RadiusX="3.15" RadiusY="3.15" Fill="#2E3540" />
                <Rectangle Canvas.Left="43.6" Canvas.Top="15.2" Width="7.4" Height="8.6" RadiusX="3.7" RadiusY="3.7" Fill="#2E3540" />
                <Path Data="M18,31.4 C22.6,44.2 33.2,46.6 41.2,38.4"
                      Stroke="#2E3540" StrokeThickness="5.3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            </Canvas>
            <!-- 2 Wednesday 开心 -->
            <Canvas x:Name="Face2" Width="64" Height="64" Visibility="Collapsed">
                <Ellipse Width="64" Height="64" Fill="#D4E8FC" />
                <Path Data="M20.4,26.2 C23.6,21 26.8,21 30,26.2"
                      Stroke="#2E3540" StrokeThickness="4.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                <Path Data="M34,26.2 C37.2,21 40.4,21 43.6,26.2"
                      Stroke="#2E3540" StrokeThickness="4.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                <Path Data="M17.5,34 C24.5,50 39.5,50 46.5,34"
                      Stroke="#2E3540" StrokeThickness="5.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            </Canvas>
            <!-- 3 Thursday 好奇 -->
            <Canvas x:Name="Face3" Width="64" Height="64" Visibility="Collapsed">
                <Ellipse Width="64" Height="64" Fill="#D4E8FC" />
                <Path Data="M36.4,13.2 C38.6,10.6 42.8,10.8 44.6,13.8"
                      Stroke="#2E3540" StrokeThickness="3.3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                <Rectangle Canvas.Left="21.4" Canvas.Top="19" Width="6.2" Height="10.4" RadiusX="3.1" RadiusY="3.1" Fill="#2E3540" />
                <Rectangle Canvas.Left="36.6" Canvas.Top="16" Width="6.2" Height="10.4" RadiusX="3.1" RadiusY="3.1" Fill="#2E3540" />
                <Path Data="M22.5,37.4 C27.6,42.6 36.4,43.4 43.4,36"
                      Stroke="#2E3540" StrokeThickness="4.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            </Canvas>
            <!-- 4 Friday 得意 -->
            <Canvas x:Name="Face4" Width="64" Height="64" Visibility="Collapsed">
                <Ellipse Width="64" Height="64" Fill="#D4E8FC" />
                <Rectangle Canvas.Left="20.8" Canvas.Top="16.8" Width="6.3" Height="11.2" RadiusX="3.15" RadiusY="3.15" Fill="#2E3540" />
                <Path Data="M35.2,25.6 C38.67,20.67 42.13,20.27 45.6,24.4"
                      Stroke="#2E3540" StrokeThickness="4.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                <Path Data="M19.5,36.2 C26.5,41.6 37.2,46.4 46.4,33"
                      Stroke="#2E3540" StrokeThickness="5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            </Canvas>
            <!-- 5 Saturday 困倦 -->
            <Canvas x:Name="Face5" Width="64" Height="64" Visibility="Collapsed">
                <Ellipse Width="64" Height="64" Fill="#D4E8FC" />
                <Rectangle Canvas.Left="19.4" Canvas.Top="22.8" Width="11.6" Height="5.2" RadiusX="2.6" RadiusY="2.6" Fill="#2E3540" />
                <Rectangle Canvas.Left="33" Canvas.Top="22.8" Width="11.6" Height="5.2" RadiusX="2.6" RadiusY="2.6" Fill="#2E3540" />
                <Path Data="M25,38.4 C28.4,42.4 35.6,42.4 39,38.4"
                      Stroke="#2E3540" StrokeThickness="4.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
            </Canvas>
            <!-- 6 Sunday 惊讶 -->
            <Canvas x:Name="Face6" Width="64" Height="64" Visibility="Collapsed">
                <Ellipse Width="64" Height="64" Fill="#D4E8FC" />
                <Ellipse Canvas.Left="20.7" Canvas.Top="18.7" Width="9" Height="9" Fill="#2E3540" />
                <Ellipse Canvas.Left="34.3" Canvas.Top="18.7" Width="9" Height="9" Fill="#2E3540" />
                <Ellipse Canvas.Left="27.6" Canvas.Top="34.6" Width="8.8" Height="11.2" Fill="#2E3540" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
