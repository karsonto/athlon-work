<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Athlon.Agent.App">

    <!-- Control styles are grouped by control family. The parts are merged in their former
         definition order, so StaticResource/DynamicResource resolution and key lookup are
         unchanged by the split. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Buttons.xaml" />
        <ResourceDictionary Source="Controls.Menus.xaml" />
        <ResourceDictionary Source="Controls.Inputs.xaml" />
        <ResourceDictionary Source="Controls.Sidebar.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
