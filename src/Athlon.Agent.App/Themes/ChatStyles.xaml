<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Athlon.Agent.App"
                    xmlns:controls="clr-namespace:Athlon.Agent.App.Controls"
                    xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">

    <!-- Chat styles are grouped by family. The parts are merged in their former definition
         order, so StaticResource/DynamicResource resolution and key lookup are unchanged. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ChatStyles.Composer.xaml" />
        <ResourceDictionary Source="ChatStyles.Panels.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
