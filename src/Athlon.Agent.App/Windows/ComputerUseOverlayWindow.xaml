<Window x:Class="Athlon.Agent.App.Windows.ComputerUseOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
        Title="{loc:Localize Key=ComputerUse_MenuStart}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="880">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Border Background="#F8FAFC"
            BorderBrush="#D0D7E2"
            BorderThickness="1"
            CornerRadius="18"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.22"
                              Color="#0F172A" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{loc:Localize Key=ComputerUse_MenuStart}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center" />
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Click="CloseButton_OnClick"
                    ToolTip="{loc:Localize Key=Common_Close}"
                    Width="28"
                    Height="28"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    BorderBrush="#D0D7E2"
                    BorderThickness="1"
                    Foreground="#334155"
                    Content="×" />

            <Grid Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptBox"
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         MinHeight="42"
                         FontSize="14"
                         Padding="12,8"
                         BorderThickness="1"
                         BorderBrush="#CBD5E1"
                         Background="White"
                         Foreground="#0F172A"
                         KeyDown="PromptBox_OnKeyDown"
                         Text="{Binding PromptText, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        MinWidth="92"
                        Padding="12,8"
                        Click="SendButton_OnClick"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Content="{loc:Localize Key=ComputerUse_Send}" />
            </Grid>
        </Grid>
    </Border>
</Window>
