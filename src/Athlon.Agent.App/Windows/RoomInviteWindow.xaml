<Window x:Class="Athlon.Agent.App.Windows.RoomInviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
        Title="{loc:Localize Key=Shell_ChatRoomTitle}"
        Icon="/Assets/app-icon.ico"
        Height="640"
        Width="720"
        MinHeight="520"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.AppBackground}"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Background="{DynamicResource Brush.AppBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Chrome}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="12,0">
                    <TextBlock Text="{loc:Localize Key=Shell_ChatRoomTitle}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.SubtleText}"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            ToolTip="{loc:Localize Key=Common_Close}"
                            Click="CloseButton_OnClick"
                            ContentTemplate="{StaticResource WindowCaptionCloseIconTemplate}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowCloseCaptionButtonStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0"
                        Background="{DynamicResource Brush.Chrome}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="10,8">
                            <Button Content="{loc:Localize Key=Shell_ChatRoomNew}"
                                    Padding="10,6"
                                    Margin="0,0,0,6"
                                    Click="NewRoomButton_OnClick" />
                            <Button Content="{loc:Localize Key=Shell_ChatRoomStopAll}"
                                    Padding="10,6"
                                    Click="StopAllButton_OnClick" />
                        </StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{loc:Localize Key=Shell_ChatRoomListHint}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.SubtleText}"
                                       Margin="12,12,12,8"
                                       FontSize="11" />
                            <ListBox x:Name="RoomList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     SelectionChanged="RoomList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WorkspaceLabel}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.SubtleText}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="#E53935"
                                                    CornerRadius="8"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding UnreadVisibility}">
                                                <TextBlock Text="{Binding UnreadLabel}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <Border x:Name="BindWarningBanner"
                                Background="#3D2A1A"
                                BorderBrush="#E0A040"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock x:Name="BindWarningText"
                                       TextWrapping="Wrap"
                                       Foreground="#FFD899"
                                       FontSize="12" />
                        </Border>

                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomInviteHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   Margin="0,0,0,12" />
                        <TextBox x:Name="InviteUrlBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinHeight="56"
                                 Padding="10,8"
                                 VerticalScrollBarVisibility="Auto" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CopyLinkButton"
                                    Content="{loc:Localize Key=Shell_ChatRoomCopyLink}"
                                    MinWidth="88"
                                    Margin="0,0,8,0"
                                    Padding="10,5"
                                    Click="CopyButton_OnClick" />
                            <Button Content="{loc:Localize Key=Shell_ChatRoomOpenBrowser}"
                                    MinWidth="88"
                                    Margin="0,0,8,0"
                                    Padding="10,5"
                                    Click="OpenBrowserButton_OnClick" />
                            <Button Content="{loc:Localize Key=Shell_ChatRoomCloseRoom}"
                                    MinWidth="88"
                                    Padding="10,5"
                                    Click="CloseRoomButton_OnClick" />
                        </StackPanel>

                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomWorkspace}"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,4" />
                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomWorkspaceHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   Margin="0,0,0,8" />
                        <ComboBox x:Name="WorkspaceCombo"
                                  DisplayMemberPath="Label"
                                  MinHeight="32"
                                  SelectionChanged="WorkspaceCombo_OnSelectionChanged" />

                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomAgentCaps}"
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,6" />
                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomAgentCapsHint}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.SubtleText}"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomTools}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="ToolList" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomSkills}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="SkillList" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Localize Key=Shell_ChatRoomMcp}" Margin="0,0,0,4" />
                        <ItemsControl x:Name="McpList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,12,24,20">
                <Button Content="{loc:Localize Key=Shell_ChatRoomSaveCaps}"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="SaveCapsButton_OnClick" />
                <Button Content="{loc:Localize Key=Common_Close}"
                        MinWidth="88"
                        Padding="12,6"
                        IsDefault="True"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
