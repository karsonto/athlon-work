<Window x:Class="Athlon.Agent.App.Windows.TeamTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Team Trace"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource PreviewWindowStyle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Text="Team Trace"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.SubtleText}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button ToolTip="{loc:Localize Key=Common_Minimize}"
                            Click="MinimizeButton_OnClick"
                            ContentTemplate="{StaticResource WindowCaptionMinimizeIconTemplate}"
                            Style="{StaticResource WindowCaptionButtonStyle}" />
                    <Button x:Name="MaximizeRestoreButton"
                            ToolTip="{loc:Localize Key=Common_Maximize}"
                            Click="MaximizeRestoreButton_OnClick"
                            ContentTemplate="{StaticResource WindowCaptionMaximizeIconTemplate}"
                            Style="{StaticResource WindowCaptionButtonStyle}" />
                    <Button ToolTip="{loc:Localize Key=Common_Close}"
                            Click="CloseButton_OnClick"
                            ContentTemplate="{StaticResource WindowCaptionCloseIconTemplate}"
                            Style="{StaticResource WindowCloseCaptionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="0"
                ClipToBounds="True">
            <wv2:WebView2 x:Name="TraceWebView" />
        </Border>
    </Grid>
</Window>
