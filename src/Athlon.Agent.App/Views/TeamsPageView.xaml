<UserControl x:Class="Athlon.Agent.App.Views.TeamsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
             xmlns:vm="clr-namespace:Athlon.Agent.App.ViewModels"
             Background="{DynamicResource Brush.ChatBackground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/TeamsPageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding TeamsPageVm}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Team list -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="14,14,14,10"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="＋"
                                ToolTip="新建 Team"
                                Command="{Binding CreateTeamCommand}"
                                Style="{StaticResource TeamsIconPrimaryButtonStyle}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding DataContext.NavigateBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource GhostIconButtonStyle}"
                                    Margin="0,0,6,0"
                                    ToolTip="{loc:Localize Key=Common_Back}"
                                    Content="←" />
                            <TextBlock Text="Agent Teams"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding TeamItems}"
                         SelectedItem="{Binding SelectedTeamItem}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource TeamsListItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TeamListItemViewModel}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Meta}"
                                           Foreground="{DynamicResource Brush.SubtleText}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Teams" Foreground="{DynamicResource Brush.SubtleText}" VerticalAlignment="Center" />
                        <TextBlock Text="/" Margin="8,0" Foreground="{DynamicResource Brush.SubtleText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EditingTeamName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TeamsBadgeStyle}">
                                    <Setter Property="Background" Value="{StaticResource Teams.WarnSoft}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TeamsEnabled}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Teams.SuccessSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EnabledBadgeText}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Teams.Warn}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeamsEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Teams.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <CheckBox Content="启用"
                                  IsChecked="{Binding TeamsEnabled}"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource McpToggleSwitchStyle}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="创建示例" Command="{Binding CreateSampleTeamCommand}"
                                Style="{StaticResource TeamsSecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="打开 Trace" Command="{Binding OpenSelectedTraceCommand}"
                                Style="{StaticResource TeamsSecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="删除 Team" Command="{Binding DeleteTeamCommand}"
                                Style="{StaticResource TeamsDangerButtonStyle}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding HasSelectedTeam}" />
                        <Button Content="保存" Command="{Binding SaveAllCommand}"
                                Style="{StaticResource TeamsPrimaryButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="360" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Team basics + members -->
                    <Border Grid.Column="0" Style="{StaticResource TeamsCardStyle}" Margin="0,0,16,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource TeamsCardHeaderStyle}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource TeamsBadgeStyle}"
                                            Background="{StaticResource Teams.WarnSoft}">
                                        <TextBlock Text="配置" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Teams.Warn}" />
                                    </Border>
                                    <TextBlock Text="Team 基本信息" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource TeamsCardBodyStyle}">
                                <StackPanel>
                                    <Border Style="{StaticResource TeamsHintStyle}">
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource Brush.SubtleText}">
                                            <Run Text="一期采用 " /><Run FontWeight="SemiBold" Text="Leader + Workers" /><Run Text="：这里配置成员职责与能力边界；运行时由 Leader 拆任务分派。右侧可预览组织结构，Trace 为独立弹窗。" />
                                        </TextBlock>
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Team 名称" Style="{StaticResource TeamsFieldLabelStyle}" />
                                            <TextBox Text="{Binding EditingTeamName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="最大并行 Worker" Style="{StaticResource TeamsFieldLabelStyle}" />
                                            <TextBox Text="{Binding EditingMaxParallelWorkers, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="描述" Style="{StaticResource TeamsFieldLabelStyle}" />
                                    <TextBox Text="{Binding EditingTeamDescription, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="72" Margin="0,0,0,4" />

                                    <DockPanel Margin="0,12,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="删除 Worker"
                                                    Command="{Binding DeleteWorkerCommand}"
                                                    CommandParameter="{Binding SelectedMember}"
                                                    Style="{StaticResource TeamsDangerButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding CanDeleteSelectedWorker, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="＋ 添加 Worker"
                                                    Command="{Binding AddWorkerCommand}"
                                                    Style="{StaticResource TeamsSecondaryButtonStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="成员" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Members}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TeamMemberItemViewModel}">
                                                <Border Style="{StaticResource TeamsMemberCardStyle}"
                                                        MouseLeftButtonUp="OnMemberCardClick">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                                <Button Content="删除"
                                                                        Margin="0,0,8,0"
                                                                        Command="{Binding DataContext.DeleteWorkerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        PreviewMouseLeftButtonDown="OnDeleteWorkerButtonPreviewMouseDown">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource TeamsDangerLinkButtonStyle}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Border>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource TeamsBadgeStyle}">
                                                                            <Setter Property="Background" Value="{StaticResource Teams.WorkerSoft}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource Teams.LeaderSoft}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource Teams.Worker}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource Teams.Leader}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,8,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background">
                                                                                <Setter.Value>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                        <GradientStop Color="#FF0891B2" Offset="0" />
                                                                                        <GradientStop Color="#FF2563EB" Offset="1" />
                                                                                    </LinearGradientBrush>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                                                    <Setter Property="Background">
                                                                                        <Setter.Value>
                                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                                <GradientStop Color="#FF7C3AED" Offset="0" />
                                                                                                <GradientStop Color="#FF4F46E5" Offset="1" />
                                                                                            </LinearGradientBrush>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Initials}"
                                                                               Foreground="White"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Subtitle}"
                                                                               Foreground="{DynamicResource Brush.SubtleText}"
                                                                               FontSize="12"
                                                                               Margin="0,2,0,0"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <ItemsControl ItemsSource="{Binding Caps}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:CapChipViewModel}">
                                                                    <Border Style="{StaticResource TeamsChipStyle}">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   FontSize="11"
                                                                                   FontFamily="Consolas"
                                                                                   Foreground="{DynamicResource Brush.SubtleText}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Margin="0,8,0,0"
                                            Background="{DynamicResource Brush.ChatBackground}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="运行 Team Task" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding RunGoal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                            <TextBlock Text="推荐在 Chat 切换到 Teams 模式发送目标。此处试跑仍需当前会话。"
                                                       Foreground="{DynamicResource Brush.SubtleText}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <Button Content="试跑（当前 Chat 会话）"
                                                    Command="{Binding RunSelectedTeamCommand}"
                                                    HorizontalAlignment="Left">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TeamsPrimaryButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="{DynamicResource Brush.SubtleText}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Profile panel -->
                    <Border Grid.Column="1" Style="{StaticResource TeamsCardStyle}" Margin="0,0,0,16"
                            Visibility="{Binding HasSelectedTeam, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource TeamsCardHeaderStyle}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource TeamsBadgeStyle}">
                                                <Setter Property="Background" Value="{StaticResource Teams.WorkerSoft}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMember.IsLeader}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Teams.LeaderSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedMember.RoleLabel}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Teams.Worker}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedMember.IsLeader}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Teams.Leader}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding EditingMemberName, StringFormat=成员能力 · {0}}" />
                                </DockPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource TeamsCardBodyStyle}">
                                    <StackPanel>
                                        <TextBlock Text="显示名称" Style="{StaticResource TeamsFieldLabelStyle}" />
                                        <TextBox Text="{Binding EditingMemberName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                        <TextBlock Text="职责（写入 AGENT.md）" Style="{StaticResource TeamsFieldLabelStyle}" />
                                        <TextBox Text="{Binding EditingMemberAgentMd, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="96" Margin="0,0,0,12" />

                                        <TextBlock Text="一句话职责（卡片副标题）" Style="{StaticResource TeamsFieldLabelStyle}" />
                                        <TextBox Text="{Binding EditingMemberDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoopPolicyEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="允许被循环重派" Style="{StaticResource TeamsFieldLabelStyle}" />
                                                <CheckBox Content="是 · Leader 可多次 dispatch"
                                                          IsChecked="{Binding EditingAllowRedispatch}"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource TeamsCheckBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="MaxIterations（防死循环）" Style="{StaticResource TeamsFieldLabelStyle}" />
                                                <TextBox Text="{Binding EditingMaxIterations, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource TeamsHintStyle}" Margin="0,0,0,12">
                                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource Brush.SubtleText}"
                                                       Text="循环由 Leader 发起（非 Worker 自循环）。达到上限后必须汇总或 ask_user。Trace 用橙色 loop 边展示。" />
                                        </Border>

                                        <!-- Tabs -->
                                        <Border Background="{DynamicResource Brush.ChatBackground}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4"
                                                Margin="0,0,0,12">
                                            <UniformGrid Columns="4">
                                                <RadioButton Content="工具" GroupName="TeamsCaps"
                                                             IsChecked="{Binding IsToolsTab, Mode=OneWay}"
                                                             Command="{Binding SelectCapabilityTabCommand}"
                                                             CommandParameter="tools"
                                                             Style="{StaticResource TeamsTabButtonStyle}" />
                                                <RadioButton Content="Skills" GroupName="TeamsCaps"
                                                             IsChecked="{Binding IsSkillsTab, Mode=OneWay}"
                                                             Command="{Binding SelectCapabilityTabCommand}"
                                                             CommandParameter="skills"
                                                             Style="{StaticResource TeamsTabButtonStyle}" />
                                                <RadioButton Content="MCP" GroupName="TeamsCaps"
                                                             IsChecked="{Binding IsMcpTab, Mode=OneWay}"
                                                             Command="{Binding SelectCapabilityTabCommand}"
                                                             CommandParameter="mcp"
                                                             Style="{StaticResource TeamsTabButtonStyle}" />
                                                <RadioButton Content="知识库" GroupName="TeamsCaps"
                                                             IsChecked="{Binding IsKnowledgeTab, Mode=OneWay}"
                                                             Command="{Binding SelectCapabilityTabCommand}"
                                                             CommandParameter="kb"
                                                             Style="{StaticResource TeamsTabButtonStyle}" />
                                            </UniformGrid>
                                        </Border>

                                        <ItemsControl Visibility="{Binding IsToolsTab, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding ToolOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CapabilityOptionViewModel}">
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource TeamsCheckItemStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.45" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  IsEnabled="{Binding IsEnabled}"
                                                                  Style="{StaticResource TeamsCheckBoxStyle}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl Visibility="{Binding IsSkillsTab, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding SkillOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CapabilityOptionViewModel}">
                                                    <Border Style="{StaticResource TeamsCheckItemStyle}">
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource TeamsCheckBoxStyle}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl Visibility="{Binding IsMcpTab, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding McpOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CapabilityOptionViewModel}">
                                                    <Border Style="{StaticResource TeamsCheckItemStyle}">
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource TeamsCheckBoxStyle}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl Visibility="{Binding IsKnowledgeTab, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding KnowledgeOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CapabilityOptionViewModel}">
                                                    <Border Style="{StaticResource TeamsCheckItemStyle}">
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource TeamsCheckBoxStyle}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Org preview -->
                                        <TextBlock Text="组织预览" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,8" />
                                        <Border CornerRadius="10" Padding="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1F6366F1" Offset="0" />
                                                    <GradientStop Color="#140891B2" Offset="0.55" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Style="{StaticResource TeamsPreviewNodeStyle}"
                                                        BorderBrush="{StaticResource Teams.Leader}"
                                                        HorizontalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border Style="{StaticResource TeamsBadgeStyle}" Background="{StaticResource Teams.LeaderSoft}" HorizontalAlignment="Center">
                                                            <TextBlock Text="Leader" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Teams.Leader}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding PreviewLeaderName}" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Rectangle Width="2" Height="18" Fill="{DynamicResource Brush.Border}" Margin="0,4" HorizontalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding PreviewWorkers}" HorizontalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:OrgPreviewNodeViewModel}">
                                                            <Border Style="{StaticResource TeamsPreviewNodeStyle}"
                                                                    BorderBrush="{StaticResource Teams.Worker}"
                                                                    Margin="5">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <Border Style="{StaticResource TeamsBadgeStyle}" Background="{StaticResource Teams.WorkerSoft}" HorizontalAlignment="Center">
                                                                        <TextBlock Text="W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Teams.Worker}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="120" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
