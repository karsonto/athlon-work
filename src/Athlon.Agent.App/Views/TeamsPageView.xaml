<UserControl x:Class="Athlon.Agent.App.Views.TeamsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization">
    <ScrollViewer Padding="40,32" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.ChatBackground}">
        <StackPanel MaxWidth="860" DataContext="{Binding TeamsPageVm}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Chat"
                        Style="{StaticResource GhostIconButtonStyle}"
                        Margin="0,0,8,0"
                        Content="←" />
                <TextBlock Text="Agent Teams"
                           FontSize="28"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Configure Leader / Worker profiles, run a Team Task, open Trace popup."
                       Foreground="{DynamicResource Brush.SubtleText}"
                       Margin="0,0,0,20" />

            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Enable Teams" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="When enabled, Leader tools register at next app start. Default is off."
                                   Foreground="{DynamicResource Brush.SubtleText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding TeamsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Save" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Teams" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Create sample team"
                                Command="{Binding CreateSampleTeamCommand}"
                                Style="{StaticResource GhostIconButtonStyle}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Teams}"
                             SelectedItem="{Binding SelectedTeam}"
                             DisplayMemberPath="Name"
                             Height="120"
                             Margin="0,0,0,12" />
                    <TextBlock Text="Selected team description" Foreground="{DynamicResource Brush.SubtleText}" />
                    <TextBox Text="{Binding SelectedTeam.Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <Button Content="Save team" Command="{Binding SaveTeamCommand}" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Profiles" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             DisplayMemberPath="Name"
                             Height="120"
                             Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Name" />
                            <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="AGENT.md" />
                            <TextBox Text="{Binding SelectedProfile.AgentMd, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="0,4,0,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox Content="Allow Redispatch" IsChecked="{Binding SelectedProfile.AllowRedispatch}" Margin="0,0,0,8" />
                            <TextBlock Text="MaxIterations" />
                            <TextBox Text="{Binding SelectedProfile.MaxIterations, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <Button Content="Save profile" Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Run Team Task" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                    <TextBlock Text="Uses the active chat session as RootSessionId. Opens Trace popup when done."
                               Foreground="{DynamicResource Brush.SubtleText}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding RunGoal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Run selected team" Command="{Binding RunSelectedTeamCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Open latest Trace" Command="{Binding OpenSelectedTraceCommand}"
                                Style="{StaticResource GhostIconButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.SubtleText}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
