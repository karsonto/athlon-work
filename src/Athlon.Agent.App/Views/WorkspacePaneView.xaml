<UserControl x:Class="Athlon.Agent.App.Views.WorkspacePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Athlon.Agent.App"
             xmlns:controls="clr-namespace:Athlon.Agent.App.Controls"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Athlon.Agent.App.ViewModels"
             Background="{DynamicResource Brush.AppBackground}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:FilesWorkspaceTabViewModel}">
            <controls:WorkspaceFilesPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsWorkspaceTabViewModel}">
            <controls:WorkspaceSkillsPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserWorkspaceTabViewModel}">
            <controls:BrowserWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TerminalWorkspaceTabViewModel}">
            <controls:TerminalWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangesWorkspaceTabViewModel}">
            <controls:ChangesReviewView />
        </DataTemplate>

        <Style x:Key="WorkspaceShortcutPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WorkspaceShortcutTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WorkspaceEmptyRowStyle" TargetType="Button" BasedOn="{StaticResource ComposerModeMenuItemStyle}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="WorkspaceEmptyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <Style x:Key="WorkspaceLauncherCardStyle" TargetType="Button">
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.HoverNeutral}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceLauncherIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
        </Style>

        <Style x:Key="WorkspaceLauncherLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,8,4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip (hidden when empty) -->
        <Border Grid.Row="0"
                Height="{x:Static app:AppLayoutMetrics.SplitPaneHeaderHeight}"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="4,0,8,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkspacePane.IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ListBox ItemsSource="{Binding WorkspacePane.Tabs}"
                                 SelectedItem="{Binding WorkspacePane.ActiveTab, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource EditorTabListStyle}"
                                 ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Margin="10,0,0,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource WorkspaceTabPackIconStyle}">
                                                    <Setter Property="Kind" Value="FolderOutline" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Browser">
                                                            <Setter Property="Kind" Value="Earth" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Terminal">
                                                            <Setter Property="Kind" Value="Console" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Files">
                                                            <Setter Property="Kind" Value="FolderOutline" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Skills">
                                                            <Setter Property="Kind" Value="StarOutline" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Changes">
                                                            <Setter Property="Kind" Value="SourceBranch" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,4,0"
                                                   MaxWidth="148"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   FontSize="12" />
                                        <Button Grid.Column="2"
                                                Content="×"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.WorkspacePane.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Localize Key=Common_Close}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EditorTabCloseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanClose}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid VerticalAlignment="Center" Margin="2,0,0,0">
                            <Button x:Name="AddTabButton"
                                    Command="{Binding WorkspacePane.ToggleAddMenuCommand}"
                                    Content="+"
                                    Width="28"
                                    Height="28"
                                    FontSize="16"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{loc:Localize Key=Workspace_AddTabTooltip}" />
                            <Popup PlacementTarget="{Binding ElementName=AddTabButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-140"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding WorkspacePane.IsAddMenuOpen, Mode=TwoWay}">
                                <Border Background="Transparent" Padding="12" Margin="-12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20"
                                                          ShadowDepth="3"
                                                          Direction="270"
                                                          Opacity="0.18"
                                                          Color="#FF000000" />
                                    </Border.Effect>
                                    <Border Background="{DynamicResource Brush.MenuBackground}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="6"
                                            MinWidth="220">
                                        <StackPanel>
                                            <Button Command="{Binding OpenChangesWorkspaceTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="SourceBranch"
                                                                             Style="{StaticResource WorkspacePackIconStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Context_TabChanges}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding WorkspacePane.AddBrowserTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="Earth"
                                                                             Style="{StaticResource WorkspacePackIconStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Workspace_Browser}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                    <Border Grid.Column="2"
                                                            Style="{StaticResource WorkspaceShortcutPillStyle}"
                                                            Margin="12,0,0,0">
                                                        <TextBlock Text="Ctrl+T" Style="{StaticResource WorkspaceShortcutTextStyle}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding WorkspacePane.AddTerminalTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="Console"
                                                                             Style="{StaticResource WorkspacePackIconStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Workspace_Terminal}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding WorkspacePane.AddFilesTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="FolderOutline"
                                                                             Style="{StaticResource WorkspacePackIconStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Context_TabFiles}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding WorkspacePane.AddSkillsTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="StarOutline"
                                                                             Style="{StaticResource WorkspacePackIconStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Context_TabSkills}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding StartComputerUseOverlayCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="Monitor"
                                                                             Style="{StaticResource WorkspacePackIconStyle}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=ComputerUse_MenuStart}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Column="1"
                        Command="{Binding ToggleWorkspaceMaximizedCommand}"
                        ToolTip="{Binding WorkspaceMaximizeToolTip}"
                        Width="28"
                        Height="28"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="ContentTemplate" Value="{StaticResource WorkspaceMaximizeIconTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WorkspacePane.CanMaximizeActiveTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWorkspaceMaximized}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource WorkspaceRestoreIconTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Empty state: launcher rows -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.AppBackground}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkspacePane.IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="108" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="108" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="0"
                        Command="{Binding OpenChangesWorkspaceTabCommand}"
                        Style="{StaticResource WorkspaceLauncherCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="SourceBranch"
                                                 Style="{StaticResource WorkspaceLauncherIconStyle}" />
                        <TextBlock Text="{loc:Localize Key=Context_TabChanges}"
                                   Style="{StaticResource WorkspaceLauncherLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Command="{Binding WorkspacePane.AddBrowserTabCommand}"
                        Style="{StaticResource WorkspaceLauncherCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Earth"
                                                 Style="{StaticResource WorkspaceLauncherIconStyle}" />
                        <TextBlock Text="{loc:Localize Key=Workspace_Browser}"
                                   Style="{StaticResource WorkspaceLauncherLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1"
                        Grid.Column="0"
                        Command="{Binding WorkspacePane.AddTerminalTabCommand}"
                        Style="{StaticResource WorkspaceLauncherCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ConsoleLine"
                                                 Style="{StaticResource WorkspaceLauncherIconStyle}" />
                        <TextBlock Text="{loc:Localize Key=Workspace_Terminal}"
                                   Style="{StaticResource WorkspaceLauncherLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Command="{Binding WorkspacePane.AddFilesTabCommand}"
                        Style="{StaticResource WorkspaceLauncherCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                 Style="{StaticResource WorkspaceLauncherIconStyle}" />
                        <TextBlock Text="{loc:Localize Key=Context_TabFiles}"
                                   Style="{StaticResource WorkspaceLauncherLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2"
                        Grid.Column="0"
                        Command="{Binding WorkspacePane.AddSkillsTabCommand}"
                        Style="{StaticResource WorkspaceLauncherCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="StarOutline"
                                                 Style="{StaticResource WorkspaceLauncherIconStyle}" />
                        <TextBlock Text="{loc:Localize Key=Context_TabSkills}"
                                   Style="{StaticResource WorkspaceLauncherLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Command="{Binding StartComputerUseOverlayCommand}"
                        Style="{StaticResource WorkspaceLauncherCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Monitor"
                                                 Style="{StaticResource WorkspaceLauncherIconStyle}" />
                        <TextBlock Text="{loc:Localize Key=ComputerUse_MenuStart}"
                                   Style="{StaticResource WorkspaceLauncherLabelStyle}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Active tab content -->
        <ContentControl Grid.Row="1"
                        Content="{Binding WorkspacePane.ActiveTab}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkspacePane.IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

    </Grid>
</UserControl>
