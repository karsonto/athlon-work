<UserControl x:Class="Athlon.Agent.App.Views.WorkspacePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Athlon.Agent.App"
             xmlns:controls="clr-namespace:Athlon.Agent.App.Controls"
             xmlns:loc="clr-namespace:Athlon.Agent.App.Localization"
             xmlns:vm="clr-namespace:Athlon.Agent.App.ViewModels"
             Background="{DynamicResource Brush.AppBackground}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:FilesWorkspaceTabViewModel}">
            <controls:WorkspaceFilesPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsWorkspaceTabViewModel}">
            <controls:WorkspaceSkillsPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserWorkspaceTabViewModel}">
            <controls:BrowserWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TerminalWorkspaceTabViewModel}">
            <controls:TerminalWorkspaceView />
        </DataTemplate>

        <!-- Codex-like monoline icons -->
        <Style x:Key="WorkspaceIconStroke" TargetType="Shape">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <Style x:Key="WorkspaceShortcutPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WorkspaceShortcutTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WorkspaceEmptyRowStyle" TargetType="Button" BasedOn="{StaticResource ComposerModeMenuItemStyle}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="WorkspaceEmptyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip (hidden when empty) -->
        <Border Grid.Row="0"
                Height="{x:Static app:AppLayoutMetrics.SplitPaneHeaderHeight}"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="4,0,8,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkspacePane.IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ListBox ItemsSource="{Binding WorkspacePane.Tabs}"
                                 SelectedItem="{Binding WorkspacePane.ActiveTab, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource EditorTabListStyle}"
                                 ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Kind icon (Codex-style monoline) -->
                                        <Grid Grid.Column="0"
                                              Width="16"
                                              Height="16"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center">
                                            <Viewbox Width="15" Height="15">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Browser">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Canvas Width="16" Height="16">
                                                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13"
                                                             Style="{StaticResource WorkspaceIconStroke}" />
                                                    <Ellipse Canvas.Left="5.25" Canvas.Top="1.5" Width="5.5" Height="13"
                                                             Style="{StaticResource WorkspaceIconStroke}" />
                                                    <Line X1="1.5" Y1="8" X2="14.5" Y2="8"
                                                          Style="{StaticResource WorkspaceIconStroke}" />
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox Width="14" Height="14">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Terminal">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Canvas Width="16" Height="16">
                                                    <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="12"
                                                               RadiusX="2" RadiusY="2"
                                                               Style="{StaticResource WorkspaceIconStroke}" />
                                                    <Polyline Points="4.5,6 6.5,8 4.5,10"
                                                              Style="{StaticResource WorkspaceIconStroke}" />
                                                    <Line X1="8" Y1="10.5" X2="11.5" Y2="10.5"
                                                          Style="{StaticResource WorkspaceIconStroke}" />
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox Width="14" Height="14">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Files">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Canvas Width="16" Height="16">
                                                    <Path Data="M2,3.5 H6.2 L7.6,5.2 H14 V13.5 H2 Z"
                                                          Style="{StaticResource WorkspaceIconStroke}" />
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox Width="13" Height="13">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Skills">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Canvas Width="16" Height="16">
                                                    <Path Data="M8,1.5 L9.6,6.2 L14.5,6.2 L10.5,9.1 L12.1,13.8 L8,11 L3.9,13.8 L5.5,9.1 L1.5,6.2 L6.4,6.2 Z"
                                                          Style="{StaticResource WorkspaceIconStroke}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,4,0"
                                                   MaxWidth="148"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   FontSize="12" />
                                        <Button Grid.Column="2"
                                                Content="×"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.WorkspacePane.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Localize Key=Common_Close}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EditorTabCloseButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanClose}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid VerticalAlignment="Center" Margin="2,0,0,0">
                            <Button x:Name="AddTabButton"
                                    Command="{Binding WorkspacePane.ToggleAddMenuCommand}"
                                    Content="+"
                                    Width="28"
                                    Height="28"
                                    FontSize="16"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{loc:Localize Key=Workspace_AddTabTooltip}" />
                            <Popup PlacementTarget="{Binding ElementName=AddTabButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-140"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding WorkspacePane.IsAddMenuOpen, Mode=TwoWay}">
                                <Border Background="Transparent" Padding="12" Margin="-12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20"
                                                          ShadowDepth="3"
                                                          Direction="270"
                                                          Opacity="0.18"
                                                          Color="#FF000000" />
                                    </Border.Effect>
                                    <Border Background="{DynamicResource Brush.MenuBackground}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="6"
                                            MinWidth="220">
                                        <StackPanel>
                                            <Button Command="{Binding WorkspacePane.AddBrowserTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Canvas Width="16" Height="16">
                                                            <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13"
                                                                     Style="{StaticResource WorkspaceIconStroke}" />
                                                            <Ellipse Canvas.Left="5.25" Canvas.Top="1.5" Width="5.5" Height="13"
                                                                     Style="{StaticResource WorkspaceIconStroke}" />
                                                            <Line X1="1.5" Y1="8" X2="14.5" Y2="8"
                                                                  Style="{StaticResource WorkspaceIconStroke}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Workspace_Browser}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                    <Border Grid.Column="2"
                                                            Style="{StaticResource WorkspaceShortcutPillStyle}"
                                                            Margin="12,0,0,0">
                                                        <TextBlock Text="Ctrl+T" Style="{StaticResource WorkspaceShortcutTextStyle}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding WorkspacePane.AddTerminalTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Canvas Width="16" Height="16">
                                                            <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="12"
                                                                       RadiusX="2" RadiusY="2"
                                                                       Style="{StaticResource WorkspaceIconStroke}" />
                                                            <Polyline Points="4.5,6 6.5,8 4.5,10"
                                                                      Style="{StaticResource WorkspaceIconStroke}" />
                                                            <Line X1="8" Y1="10.5" X2="11.5" Y2="10.5"
                                                                  Style="{StaticResource WorkspaceIconStroke}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Workspace_Terminal}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding WorkspacePane.AddFilesTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M2,3.5 H6.2 L7.6,5.2 H14 V13.5 H2 Z"
                                                                  Style="{StaticResource WorkspaceIconStroke}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Context_TabFiles}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding WorkspacePane.AddSkillsTabCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Data="M8,1.5 L9.6,6.2 L14.5,6.2 L10.5,9.1 L12.1,13.8 L8,11 L3.9,13.8 L5.5,9.1 L1.5,6.2 L6.4,6.2 Z"
                                                                  Style="{StaticResource WorkspaceIconStroke}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=Context_TabSkills}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding StartComputerUseOverlayCommand}"
                                                    Style="{StaticResource WorkspaceEmptyRowStyle}"
                                                    Padding="10,9"
                                                    MinHeight="38"
                                                    Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Canvas Width="16" Height="16">
                                                            <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="9"
                                                                       RadiusX="1.5" RadiusY="1.5"
                                                                       Style="{StaticResource WorkspaceIconStroke}" />
                                                            <Line X1="5.5" Y1="11" X2="10.5" Y2="11"
                                                                  Style="{StaticResource WorkspaceIconStroke}" />
                                                            <Line X1="8" Y1="11" X2="8" Y2="13.5"
                                                                  Style="{StaticResource WorkspaceIconStroke}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{loc:Localize Key=ComputerUse_MenuStart}"
                                                               Style="{StaticResource WorkspaceEmptyLabelStyle}"
                                                               FontSize="13" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Column="1"
                        Command="{Binding ToggleWorkspaceMaximizedCommand}"
                        ToolTip="{Binding WorkspaceMaximizeToolTip}"
                        Width="28"
                        Height="28"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="ContentTemplate" Value="{StaticResource WorkspaceMaximizeIconTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WorkspacePane.CanMaximizeActiveTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWorkspaceMaximized}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource WorkspaceRestoreIconTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Empty state: Codex-like launcher rows -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.AppBackground}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkspacePane.IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Margin="28,0"
                        MaxWidth="360">
                <Button Command="{Binding WorkspacePane.AddBrowserTabCommand}"
                        Style="{StaticResource WorkspaceEmptyRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Canvas Width="16" Height="16">
                                <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13"
                                         Style="{StaticResource WorkspaceIconStroke}" />
                                <Ellipse Canvas.Left="5.25" Canvas.Top="1.5" Width="5.5" Height="13"
                                         Style="{StaticResource WorkspaceIconStroke}" />
                                <Line X1="1.5" Y1="8" X2="14.5" Y2="8"
                                      Style="{StaticResource WorkspaceIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Localize Key=Workspace_Browser}"
                                   Style="{StaticResource WorkspaceEmptyLabelStyle}" />
                        <Border Grid.Column="2" Style="{StaticResource WorkspaceShortcutPillStyle}">
                            <TextBlock Text="Ctrl+T" Style="{StaticResource WorkspaceShortcutTextStyle}" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding WorkspacePane.AddTerminalTabCommand}"
                        Style="{StaticResource WorkspaceEmptyRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="12"
                                           RadiusX="2" RadiusY="2"
                                           Style="{StaticResource WorkspaceIconStroke}" />
                                <Polyline Points="4.5,6 6.5,8 4.5,10"
                                          Style="{StaticResource WorkspaceIconStroke}" />
                                <Line X1="8" Y1="10.5" X2="11.5" Y2="10.5"
                                      Style="{StaticResource WorkspaceIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Localize Key=Workspace_Terminal}"
                                   Style="{StaticResource WorkspaceEmptyLabelStyle}" />
                    </Grid>
                </Button>

                <Button Command="{Binding WorkspacePane.AddFilesTabCommand}"
                        Style="{StaticResource WorkspaceEmptyRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="17" Height="17" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Canvas Width="16" Height="16">
                                <Path Data="M2,3.5 H6.2 L7.6,5.2 H14 V13.5 H2 Z"
                                      Style="{StaticResource WorkspaceIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Localize Key=Context_TabFiles}"
                                   Style="{StaticResource WorkspaceEmptyLabelStyle}" />
                    </Grid>
                </Button>

                <Button Command="{Binding WorkspacePane.AddSkillsTabCommand}"
                        Style="{StaticResource WorkspaceEmptyRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Canvas Width="16" Height="16">
                                <Path Data="M8,1.5 L9.6,6.2 L14.5,6.2 L10.5,9.1 L12.1,13.8 L8,11 L3.9,13.8 L5.5,9.1 L1.5,6.2 L6.4,6.2 Z"
                                      Style="{StaticResource WorkspaceIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Localize Key=Context_TabSkills}"
                                   Style="{StaticResource WorkspaceEmptyLabelStyle}" />
                    </Grid>
                </Button>

                <Button Command="{Binding StartComputerUseOverlayCommand}"
                        Style="{StaticResource WorkspaceEmptyRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="9"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Style="{StaticResource WorkspaceIconStroke}" />
                                <Line X1="5.5" Y1="11" X2="10.5" Y2="11"
                                      Style="{StaticResource WorkspaceIconStroke}" />
                                <Line X1="8" Y1="11" X2="8" Y2="13.5"
                                      Style="{StaticResource WorkspaceIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Localize Key=ComputerUse_MenuStart}"
                                   Style="{StaticResource WorkspaceEmptyLabelStyle}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Active tab content -->
        <ContentControl Grid.Row="1"
                        Content="{Binding WorkspacePane.ActiveTab}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkspacePane.IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

    </Grid>
</UserControl>
