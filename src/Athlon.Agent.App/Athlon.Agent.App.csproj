<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Athlon.Agent.Core\Athlon.Agent.Core.csproj" />
    <ProjectReference Include="..\Athlon.Agent.Infrastructure\Athlon.Agent.Infrastructure.csproj" />
    <ProjectReference Include="..\Athlon.Agent.Skills\Athlon.Agent.Skills.csproj" />
    <ProjectReference Include="..\Athlon.Agent.Mcp\Athlon.Agent.Mcp.csproj" />
    <ProjectReference Include="..\Athlon.Agent.Cli\Athlon.Agent.Cli.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <GlobalPropertiesToRemove>TargetFramework</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
    <!-- Direct ref so ConPTY build targets copy OpenConsole.exe (transitive assets are skipped). -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Speech" Version="10.0.10" />
    <PackageReference Include="Velopack" Version="$(VelopackVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- ConPTY props import before this file sets PlatformTarget; force OpenConsole host copy. -->
    <ConptyNativePlatform>x64</ConptyNativePlatform>
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NeutralResourcesLanguage>zh-CN</NeutralResourcesLanguage>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Athlon.Agent.App.Program</StartupObject>
    <Version>3.0.1</Version>
    <AssemblyVersion>3.0.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Athlon.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon-48.png" />
    <Resource Include="Assets\app-icon-64.png" />
    <Resource Include="Assets\app-icon-128.png" />
    <Content Include="Assets\Mermaid\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Chat\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Browser\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Embed so ARIA tools work even if Content copy is skipped (publish / alternate output). -->
    <EmbeddedResource Include="Assets\Browser\athlon-aria-host.js">
      <LogicalName>Athlon.Agent.App.Assets.Browser.athlon-aria-host.js</LogicalName>
    </EmbeddedResource>
    <Content Include="runtimes\webview2\**\*" Condition="Exists('runtimes\webview2\x64\msedgewebview2.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyAthlonCli" AfterTargets="Build">
    <PropertyGroup>
      <_CliOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Athlon.Agent.Cli\bin\$(Configuration)\net10.0\'))</_CliOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_CliFiles Include="$(_CliOutDir)athlon*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_CliFiles)' != ''" />
  </Target>

  <Target Name="PublishAthlonCli" AfterTargets="Publish">
    <PropertyGroup>
      <_CliPublishRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_CliPublishRid>
      <_CliPublishRid Condition="'$(RuntimeIdentifier)' == ''">win-x64</_CliPublishRid>
      <_CliPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_CliPublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Athlon.Agent.Cli\Athlon.Agent.Cli.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_CliPublishRid);SelfContained=true;PublishDir=$(_CliPublishDir)" />
  </Target>

</Project>
